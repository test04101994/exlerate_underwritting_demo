# Environment overrides (also usable as Lambda environment variables).
# Operational defaults live in config/settings.yaml; anything set here wins.
# The classification vocabulary is in config/taxonomy.yaml.

# Logging level: DEBUG | INFO | WARNING | ERROR.
CLASSIFIER_LOG_LEVEL=INFO

# Default Bedrock model id / cross-region inference profile for every agent.
# Confirm the exact id enabled for your account/region in the Bedrock console.
CLASSIFIER_MODEL=us.anthropic.claude-opus-4-8

# Optional per-agent overrides (cheaper/faster agents), keyed by function name:
# CLASSIFIER_MODEL_IDENTIFY_DOCUMENT=us.anthropic.claude-haiku-4-5
# CLASSIFIER_MODEL_EXTRACT_KEYWORDS=us.anthropic.claude-haiku-4-5

# AWS region for the Bedrock client.
AWS_REGION=us-east-1

# Standard AWS credential chain (in Lambda use the execution role instead):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Paths / plugins (override config/settings.yaml).
# CLASSIFIER_SETTINGS=config/settings.yaml
# CLASSIFIER_TAXONOMY=config/taxonomy.yaml
# CLASSIFIER_RULES_MODULE=classifier.example_rules
# CLASSIFIER_ENRICHERS_MODULE=classifier.example_enrichers
