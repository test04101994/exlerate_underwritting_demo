# Multi-stage build: React SPA → Nginx
# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM public.ecr.aws/docker/library/node:20-alpine AS builder

WORKDIR /app

COPY package*.json tsconfig.json vite.config.ts tailwind.config.ts postcss.config.js ./

RUN npm install

COPY client ./client
COPY server ./server

RUN npm run build

# ── Stage 2: Serve with Nginx ────────────────────────────────────────────────
FROM public.ecr.aws/docker/library/nginx:alpine AS production

COPY --from=builder /app/dist/public /usr/share/nginx/html
COPY infrastructure/nginx-frontend-alb.conf /etc/nginx/conf.d/default.conf

RUN apk add --no-cache curl

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
