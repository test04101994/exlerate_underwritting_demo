# Multi-stage build: Express (proxy) + Python FastAPI (API)
# Express on :3001 proxies /api/* to Python on :8000

# ── Stage 1: Build frontend + Express ────────────────────────────────────────
FROM public.ecr.aws/docker/library/node:20-alpine AS builder

WORKDIR /app

COPY package*.json tsconfig.json vite.config.ts tailwind.config.ts postcss.config.js ./
RUN npm install

COPY server ./server
COPY client ./client

RUN npm run build

# ── Stage 2: Production ──────────────────────────────────────────────────────
FROM public.ecr.aws/docker/library/node:20-alpine AS production

RUN apk add --no-cache python3 py3-pip curl supervisor

WORKDIR /app

# Node app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Python API
COPY api ./api
COPY config ./config

# Install Python deps from requirements.txt
RUN pip3 install --break-system-packages -r api/requirements.txt

# Supervisor config to run both processes
RUN mkdir -p /etc/supervisor.d
RUN cat > /etc/supervisor.d/app.ini <<'EOF'
[supervisord]
nodaemon=true
logfile=/dev/null
logfile_maxbytes=0

[program:express]
command=node dist/index.js
directory=/app
environment=NODE_ENV="production",PORT="3001",PYTHON_API_URL="http://127.0.0.1:8000"
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stderr_logfile=/dev/fd/2
stderr_logfile_maxbytes=0
autorestart=true

[program:python-api]
command=python3 -m uvicorn api.main:app --host 0.0.0.0 --port 8000
directory=/app
environment=PYTHONPATH="/app"
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stderr_logfile=/dev/fd/2
stderr_logfile_maxbytes=0
autorestart=true
EOF

# Non-root user
RUN addgroup -g 1001 -S appuser && adduser -S appuser -u 1001
RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

CMD ["supervisord", "-c", "/etc/supervisor.d/app.ini"]
