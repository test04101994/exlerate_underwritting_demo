  "fieldVisibilityControl": {
    "description": "How to control which fields appear in each section",
    "methods": {
      "includeFields": {
        "description": "Explicitly list fields to include",
        "example": {
          "fieldsToShow": [
            "broker_ref_hu_number",
            "intermediary_name",
            "broker_contact_name",
            "broker_email"
          ]
        }
      },
      "excludeFields": {
        "description": "List fields to exclude from a section",
        "example": {
          "fieldsToHide": [
            "internal_notes",
            "processing_flags",
            "system_timestamps"
          ]
        }
      },
      "conditionalFields": {
        "description": "Show fields based on conditions",
        "example": {
          "showIf": {
            "field": "policy_type",
            "value": "commercial",
            "thenShow": ["business_description", "employee_count"]
          },
          "hideIf": {
            "field": "new_customer",
            "value": true,
            "thenHide": ["previous_claims", "renewal_date"]
          }
        }
      }
    }
  },
  "sectionConfiguration": {
    "description": "How sections control field layout and display",
    "properties": {
      "type": {
        "description": "Determines the layout method for fields in the section",
        "options": {
          "field-grid": "Grid layout with configurable columns",
          "tabbed-section": "Tabbed interface for grouped fields",
          "table": "Table layout for structured data",
          "accordion": "Collapsible sections",
          "card-layout": "Card-based field grouping"
        }
      },
      "columns": {
        "description": "Number of columns in grid layout",
        "examples": {
          "columns": 1,
          "result": "Single column layout, all fields full width"
        },
        {
          "columns": 2,
          "result": "Two column layout, fields can be span-1 or span-2"
        },
        {
          "columns": 3,
          "result": "Three column layout, fields can be span-1, span-2, or span-3"
        }
      },
      "fields": {
        "description": "Array of field objects that define what appears in the section",
        "structure": {
          "id": "unique field identifier",
          "label": "display label for the field",
          "csvField": "maps to column in CSV file",
          "gridPosition": "controls width (span-1, span-2, etc.)",
          "order": "numeric order for field positioning",
          "confidenceScore": "high/medium/low for badge color"
        }
      }
    }
  },
  "customLayoutExamples": {
