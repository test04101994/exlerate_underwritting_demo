      "brokerRefNumber",
      "intermediaryName",
      "brokerContactName",
      "brokerEmail",
      "targetPremium",
      "effectiveDate",
      "contactRole",
      "firstName",
      "surname",
      "dateOfBirth",
      "contactAddress",
      "propertyAddress",
      "propertyType",
      "coverType",
      "buildingSumsInsured",
      "contentSumsInsured"
    ],
    "conditionalFields": {
      "multiProperty": {
        "condition": "hasMultipleProperties",
        "additionalSections": ["property_2", "property_3"]
      },
      "highValueItems": {
        "condition": "hasHighValueItems",
        "additionalFields": ["jewellerySchedule", "artSchedule"]
      }
    }
  },
