# Lloyd's Insurance Workflow Application - Local Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/lloyds_insurance

# Session Security
SESSION_SECRET=your-session-secret-key-here

# Jira Integration (Optional - for live Jira functionality)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_DEFAULT_PROJECT=HIS

# OpenAI/OpenRouter API (Optional - for AI functionality)
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# AWS S3 Configuration (Optional - for document storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_SESSION_TOKEN=your-aws-session-token

# Local API Configuration
LOCAL_API_URL=http://localhost:3000

# Development Configuration
NODE_ENV=development
PORT=5000